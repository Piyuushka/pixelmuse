# ============================================================
# PathFinder Access - Environment Configuration Template
# Copy this file to .env.local and populate the secrets.
# ============================================================

# 1. Supabase Credentials (PostgreSQL / PostGIS Persistence)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Google Maps Platform & Places API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key
GOOGLE_MAPS_SERVER_API_KEY=your-google-maps-server-key

# 3. OpenRouteService (ORS) Accessibility Routing
ORS_API_KEY=your-openrouteservice-api-key

# 4. Application Runtime Modes
# Set to 'true' to use in-memory mock fallback without requiring an active Supabase database
NEXT_PUBLIC_DEMO_MODE=true
DEMO_MODE=true

# 5. Security & Session Auth
JWT_SECRET=pathfinder-dev-secret-change-in-production-32ch
